# Secret — never commit this file. Never use VITE_ for the OpenAI key.
OPENAI_API_KEY=sk-your-key-here

# Optional model for Responses API research stages (default gpt-4o-mini)
# OPENAI_RESEARCH_MODEL=gpt-4o-mini

# Admin token for Knowledge Governance (required for uploads/approvals)
CHAI_ADMIN_TOKEN=change-me-to-a-long-random-string

# Official research provider: mock (default) | openai (future)
# OFFICIAL_RESEARCH_PROVIDER=mock

# Optional: middleman port (default 3001)
# PORT=3001

# OpenAI response storage for accounting research (keep false unless reviewed)
# OPENAI_STORE_RESPONSES=false
